{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sparx EA mapping manifest",
  "type": "object",
  "required": [
    "schema_version",
    "technology",
    "profile",
    "files",
    "metaclasses"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "technology": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "package_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": [
        "stereotypes",
        "tagged_values",
        "diagrams",
        "toolboxes",
        "quick_linker",
        "shapescripts"
      ],
      "properties": {
        "stereotypes": {
          "type": "string",
          "minLength": 1
        },
        "tagged_values": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "string",
          "minLength": 1
        },
        "toolboxes": {
          "type": "string",
          "minLength": 1
        },
        "quick_linker": {
          "type": "string",
          "minLength": 1
        },
        "shapescripts": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metaclasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "uml_type",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "uml_type": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "element",
              "connector",
              "diagram"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
