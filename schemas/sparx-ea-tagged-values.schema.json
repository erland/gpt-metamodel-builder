{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sparx EA tagged value mappings",
  "type": "object",
  "required": [
    "schema_version",
    "tagged_value_sets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "tagged_value_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "property",
                "tag_name"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "tag_name": {
                  "type": "string",
                  "minLength": 1
                },
                "render_as": {
                  "enum": [
                    "text",
                    "memo",
                    "enum",
                    "boolean",
                    "integer",
                    "real",
                    "date",
                    "refguid"
                  ]
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
