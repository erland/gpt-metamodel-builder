{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sparx EA diagram mappings",
  "type": "object",
  "required": [
    "schema_version",
    "diagrams"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "viewpoint",
          "base_metaclass",
          "toolbox"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "viewpoint": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "base_metaclass": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "toolbox": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "alias": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
